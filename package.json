{
  "name": "maveric-gss-db-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,vite -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "verify": "tsc --noEmit",
    "build": "vite build",
    "build:web": "vite build",
    "build:server": "tsc --noEmit",
    "build:all": "npm run build:server && npm run build:web",
    "deploy:release": "bash scripts/release-deploy.sh",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "start:web": "tsx server/web.ts",
    "smoke:values": "tsx server/satelliteValuesSmoke.ts"
  },
  "dependencies": {
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.5",
    "esbuild": "^0.28.1",
    "express": "^4.19.2",
    "multer": "^2.1.1",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.10"
  }
}
